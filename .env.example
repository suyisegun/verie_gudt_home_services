# Copy this file to .env.local and fill in real values. .env.local is gitignored — never commit secrets.

# --- Database (Neon Postgres, or any standard Postgres) ---
# Use Neon's pooled connection string (works fine over the standard pg driver adapter).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- Portal session signing ---
# Any random string, 32+ characters recommended. Generate one with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-string"

# --- Portal single-admin login ---
PORTAL_ADMIN_EMAIL="you@example.com"
# Bcrypt hash of your chosen password — generate with: node scripts/hash-password.mjs "your-password"
# IMPORTANT: the script already escapes every "$" as "\$" for you — paste its output verbatim.
# Next.js expands unescaped "$name" sequences in .env files, which silently corrupts bcrypt hashes
# (they're full of literal $ characters) if you paste one in unescaped.
PORTAL_ADMIN_PASSWORD_HASH="\$2b\$12\$replace-with-a-real-bcrypt-hash"

# --- Facebook Lead Ads webhook ---
# App Secret from your Meta App's Settings > Basic page. Used to verify webhook payload signatures.
FB_APP_SECRET="replace-with-facebook-app-secret"
# A string you make up yourself and also paste into the Meta webhook subscription dialog.
FB_WEBHOOK_VERIFY_TOKEN="replace-with-a-string-you-choose"
# A Page Access Token for the Facebook Page the leads come from, with leads_retrieval + pages_manage_ads permissions.
FB_PAGE_ACCESS_TOKEN="replace-with-facebook-page-access-token"
# Optional — defaults to v21.0 if unset.
FB_GRAPH_API_VERSION="v21.0"

# --- Website quote form (optional) ---
# Only needed for Google Places address autocomplete in components/quote-form.tsx.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""
