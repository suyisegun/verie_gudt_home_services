generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadSource {
  WEBSITE
  FACEBOOK
  MANUAL
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTED
  WON
  LOST
}

model Lead {
  id           String     @id @default(cuid())
  source       LeadSource
  status       LeadStatus @default(NEW)

  // Common contact fields, normalized across sources
  name         String?
  phone        String?
  email        String?
  address      String?

  // Website quote-form specific fields
  budget       String?
  timeline     String?
  installation String?

  // Facebook Lead Ads specific fields
  fbLeadId     String?    @unique
  fbFormId     String?
  fbFormName   String?
  fbPageId     String?

  // Full raw payload from the source, for anything not mapped above
  raw          Json?

  notes        String?

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([source])
  @@index([status])
  @@index([createdAt])
}
